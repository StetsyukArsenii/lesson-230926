<!DOCTYPE html>
<html lang="en">
<head>
<%- include('head.ejs') -%>
</head>
<body>
    <%- include ("header.ejs") -%>
    <main class="post">
        <a class="back-home" href="/">Back to home</a>
        <h1><%= products.title %></h1>
        <p><%= products.description %></p>
        <div class="imgs">
            <% (products.image || []).forEach((img) => { -%>
                <img src="/uploads/<%= img %>" alt="Ad Image">
            <% }); -%>
        </div>
    </main>
    <%- include ("footer.ejs") -%>
</body>
</html>