<header>
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark theme" title="Switch to dark theme">🌙</button>
    <h1>Advertises</h1>
    <h5>
        <% if (new Date().getHours() < 12) { -%>
            Good morning!
        <% } else if (new Date().getHours() < 18) { -%>
            Good afternoon!
        <% } else { -%>
            Good evening!
        <% } %>
    </h5>
</header>