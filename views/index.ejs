<!DOCTYPE html>
<html lang="en">
<%- include('head.ejs') -%>

    <body>
        <%- include('header.ejs') -%>
            <main>
                <div class="wrapper">
                    <% products.forEach((product, index)=> { -%>
                        <a href="/post/<%= index %>" class="ad <%= product.image && product.image.length ? '' : 'ad--text-only' %>">
                            <h3>
                                <%= product.title %>
                            </h3>
                            <% if (product.image && product.image.length) { -%>
                                <img class="ad-image" src="/uploads/<%= product.image[0] %>" alt="<%= product.title %>">
                            <% } -%>
                            <p>
                                <%= product.description %>
                            </p>
                        </a>
                        <% }); -%>
                </div>
                <%- include('modal.ejs') -%>
                    <button id="add">+</button>
            </main>
            <%- include('footer.ejs') -%>
    </body>

</html>